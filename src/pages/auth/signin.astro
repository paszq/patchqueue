---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie">
  <div class="flex min-h-screen items-center justify-center bg-slate-950 p-4 text-slate-100">
    <div class="w-full max-w-sm">
      <a
        href="/"
        class="mb-6 block text-center text-sm font-semibold tracking-tight text-slate-400 hover:text-slate-200"
      >
        PatchQueue
      </a>
      <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-6">
        <h1 class="mb-6 text-center text-lg font-semibold tracking-tight text-slate-100">Zaloguj się</h1>
        <SignInForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-slate-500">
          Nie masz konta? <a href="/auth/signup" class="text-slate-300 underline underline-offset-2 hover:text-white"
            >Załóż konto</a
          >
        </p>
      </div>
    </div>
  </div>
</Layout>
