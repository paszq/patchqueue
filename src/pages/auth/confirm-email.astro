---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Konto założone",
      description: "Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy odnośnik potwierdzający na podany adres. Kliknij go, żeby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center bg-slate-950 p-4 text-slate-100">
    <div class="w-full max-w-sm">
      <a
        href="/"
        class="mb-6 block text-center text-sm font-semibold tracking-tight text-slate-400 hover:text-slate-200"
      >
        PatchQueue
      </a>
      <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-6 text-center">
        <h1 class="mb-3 text-lg font-semibold tracking-tight text-slate-100">{content.heading}</h1>
        <p class="mb-6 text-sm text-slate-400">{content.description}</p>
        <a href="/auth/signin" class="text-sm text-slate-300 underline underline-offset-2 hover:text-white">
          {content.linkText}
        </a>
      </div>
    </div>
  </div>
</Layout>
